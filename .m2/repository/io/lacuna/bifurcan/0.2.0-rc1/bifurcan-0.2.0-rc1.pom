  <modelVersion>4.0.0</modelVersion>
  <groupId>io.lacuna</groupId>
  <artifactId>bifurcan</artifactId>
  <packaging>jar</packaging>
  <version>0.2.0-rc1</version>
  <name>bifurcan</name>
  <description>impure functional data structures</description>
  <url>https://github.com/lacuna/bifurcan</url>
  <licenses>
    <license>
      <name>MIT License</name>
    </license>
  </licenses>
  <scm>
    <url>https://github.com/lacuna/bifurcan</url>
    <connection>scm:git:git://github.com/lacuna/bifurcan.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/lacuna/bifurcan.git</developerConnection>
    <tag>779fc933936b06ed6f76c8316bcd9e398ff5249b</tag>
  </scm>
  <build>
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>test</testSourceDirectory>
    <resources>
      <resource>
        <directory>resources</directory>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>resources</directory>
      </testResource>
    </testResources>
    <directory>target</directory>
    <outputDirectory>target/classes</outputDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>1.7</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
