<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.exist-db</groupId>
        <artifactId>exist-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../exist-parent</relativePath>
    </parent>

    <artifactId>exist-indexes-jmh</artifactId>
    <packaging>jar</packaging>

    <name>eXist-db Indexes JMH benchmarks</name>
    <description>JMH Benchmarks for eXist-db index modules (ngram, range, lucene)</description>

    <properties>
        <jmh.version>1.37</jmh.version>
        <uberjar.name>${project.artifactId}-${project.version}-benchmarks</uberjar.name>
        <!--
            Override at the command line, e.g.
              mvn exec:exec -pl exist-indexes-jmh \
                  -Dbenchmark.args="NgramWhereClauseBenchmark -prof gc"
            See README.md for more recipes.
        -->
        <benchmark.args>NgramWhereClauseBenchmark -prof gc</benchmark.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>exist-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>exist-index-ngram</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>exist-index-range</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>exist-index-lucene</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!--
                conf.xml is generated by xml-maven-plugin (see below) into
                this directory; the filtering pass resolves ${basedir} so
                the embedded BrokerPool writes data under the module's
                target/test-data directory.
            -->
            <resource>
                <directory>${project.build.directory}/generated-resources/conf</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>

            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>${project.parent.relativePath}/LGPL-21-license.template.txt</header>
                            <excludes>
                                <!--
                                    The Shakespeare plays are vendored from
                                    exist-samples/.../shakespeare/. They carry
                                    the public-domain notice from Jon Bosak's
                                    1999 XML markup and we keep that intact
                                    rather than replacing it.
                                -->
                                <exclude>src/main/resources/org/exist/indexing/jmh/hamlet.xml</exclude>
                                <exclude>src/main/resources/org/exist/indexing/jmh/macbeth.xml</exclude>
                                <exclude>src/main/resources/org/exist/indexing/jmh/r_and_j.xml</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze</id>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <failOnWarning>true</failOnWarning>
                            <ignoredUnusedDeclaredDependencies>
                                <ignoredUnusedDeclaredDependency>org.openjdk.jmh:jmh-generator-annprocess:jar:${jmh.version}</ignoredUnusedDeclaredDependency>
                                <!--
                                    The index extensions are loaded reflectively at runtime by
                                    the embedded BrokerPool via conf.xml; they do not appear
                                    in the compile-time bytecode of the benchmark classes.
                                -->
                                <ignoredUnusedDeclaredDependency>org.exist-db:exist-index-ngram:jar:${project.version}</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>org.exist-db:exist-index-range:jar:${project.version}</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>org.exist-db:exist-index-lucene:jar:${project.version}</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        The parent pom restricts annotationProcessorPaths to jsr305.
                        Re-declare the full set here so the JMH annotation processor
                        runs and produces META-INF/BenchmarkList; otherwise the
                        benchmarks uber-jar has no benchmarks to run.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.code.findbugs</groupId>
                            <artifactId>jsr305</artifactId>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Generate conf.xml from the canonical indexes-integration-tests
                conf.xml by adding the plain range index module via XSLT.
                This mirrors the exist-docker pattern for log4j2.xml and avoids
                drift between this module's conf and the upstream test conf.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>xml-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-conf-xml</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>transform</goal>
                        </goals>
                        <configuration>
                            <transformationSets>
                                <transformationSet>
                                    <dir>${project.basedir}/../extensions/indexes/indexes-integration-tests/src/test/resources-filtered</dir>
                                    <includes>
                                        <include>conf.xml</include>
                                    </includes>
                                    <stylesheet>${project.basedir}/src/main/xslt/conf-jmh.xslt</stylesheet>
                                    <outputDir>${project.build.directory}/generated-resources/conf</outputDir>
                                </transformationSet>
                            </transformationSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Build a fat (shaded) uber-jar containing exist-core, the
                three index extensions, JMH, and all transitive dependencies,
                with org.openjdk.jmh.Main as the entry point. The
                ServicesResourceTransformer concatenates duplicate
                META-INF/services entries (the Saxon TransformerFactory
                ServiceLoader collision the original PR worked around).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${uberjar.name}</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <!--
                                        Shading signed JARs will fail without this.
                                        http://stackoverflow.com/questions/999489/invalid-signature-file-when-attempting-to-run-a-jar
                                    -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Run the benchmark uber-jar via `mvn exec:exec`. Default args
                run NgramWhereClauseBenchmark with JMH's GCProfiler enabled;
                override with -Dbenchmark.args="..." (see README.md).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <commandlineArgs>-jar ${project.build.directory}/${uberjar.name}.jar ${benchmark.args}</commandlineArgs>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
